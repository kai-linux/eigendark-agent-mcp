[Unit]
Description=Eigendark public ChatGPT MCP service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bitnami
Group=bitnami
WorkingDirectory=/
Environment=PYTHONUNBUFFERED=1
Environment=EIGENDARK_MCP_REQUIRE_OPENAI_MTLS=1
Environment=EIGENDARK_GPT_ACTION_REQUIRE_AUTH=1
Environment=EIGENDARK_MCP_HTTP_PORT=5003
EnvironmentFile=/etc/eigendark-agent-mcp/gpt-action.env
# Persist the process-shared sandbox key across restarts so a restart / crash
# loop cannot re-mint and exhaust the website's per-IP daily onboarding budget.
# systemd creates /var/lib/eigendark-agent-mcp (0700, service-owned) and sets
# $STATE_DIRECTORY; ProtectSystem=strict otherwise blocks all writes.
StateDirectory=eigendark-agent-mcp
StateDirectoryMode=0700
ExecStart=/opt/eigendark-agent-mcp/.venv/bin/python -m eigendark_agent_mcp.http_server
Restart=on-failure
RestartSec=3
TimeoutStartSec=30
TimeoutStopSec=20
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
MemoryMax=256M
TasksMax=64
UMask=0077

[Install]
WantedBy=multi-user.target
