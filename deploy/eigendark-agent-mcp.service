[Unit]
Description=Eigendark public ChatGPT MCP service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bitnami
Group=bitnami
WorkingDirectory=/home/bitnami/eigendark-agent-mcp
Environment=PYTHONUNBUFFERED=1
Environment=EIGENDARK_MCP_REQUIRE_OPENAI_MTLS=1
Environment=EIGENDARK_MCP_HTTP_PORT=5003
ExecStart=/home/bitnami/eigendark-agent-mcp/.venv/bin/python -m eigendark_agent_mcp.http_server
Restart=on-failure
RestartSec=3
TimeoutStartSec=30
TimeoutStopSec=20
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=tmpfs
BindReadOnlyPaths=/home/bitnami/eigendark-agent-mcp /home/bitnami/eigendark/.runtime-python
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
MemoryMax=256M
TasksMax=64
UMask=0077

[Install]
WantedBy=multi-user.target
